<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_demo_process_user_status_form" model="ir.ui.view">
        <field name="name">demo.process.user.status.form</field>
        <field name="model">demo.process.user.status</field>
        <field name="arch" type="xml">
            <form string="Demo Process User Status">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="in_process"/>
                        <field name="remarks_required"/>
                        <field name="completed_status"/>
                        <field name="is_hold_status"/>
                        <field name="is_clarification_status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_demo_process_user_status_tree" model="ir.ui.view">
        <field name="name">demo.process.user.status.tree</field>
        <field name="model">demo.process.user.status</field>
        <field name="arch" type="xml">
            <tree string="Demo Process User Status">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>


    <record id="action_demo_process_user_status" model="ir.actions.act_window">
        <field name="name">PStatus</field>
        <field name="res_model">demo.process.user.status</field>
        <field name="view_mode">tree,form</field>
    </record>


</odoo>
