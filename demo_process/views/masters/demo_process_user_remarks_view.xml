<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_demo_process_user_remarks_form" model="ir.ui.view">
        <field name="name">demo.process.user.remarks.form</field>
        <field name="model">demo.process.user.remarks</field>
        <field name="arch" type="xml">
            <form string="User Remarks">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_demo_process_user_status_tree" model="ir.ui.view">
        <field name="name">demo.process.user.remarks.tree</field>
        <field name="model">demo.process.user.remarks</field>
        <field name="arch" type="xml">
            <tree string="User Remarks">
                <field name="name"/>
            </tree>
        </field>
    </record>


    <record id="action_demo_process_user_remarks" model="ir.actions.act_window">
        <field name="name">User Remarks</field>
        <field name="res_model">demo.process.user.remarks</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
