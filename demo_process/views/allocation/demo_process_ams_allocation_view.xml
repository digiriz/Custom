<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_demo_process_ams_allocation_tree" model="ir.ui.view">
            <field name="name">ams.allocation.tree</field>
            <field name="model">demo.process</field>
            <field name="priority">0</field>
            <field name="arch" type="xml">
                <tree string="AMS" multi_edit="1">
                    <field name="received_date" optional="show"/>
                    <field name="scan_date" optional="show"/>
                    <field name="dos" optional="show"/>
                    <field name="demo_station" optional="show"/>
                    <field name="facility" optional="show"/>
                    <field name="updated_facility" optional="show"/>
                    <field name="demo_count" optional="show"/>
                    <field name="assigned_employee_id" optional="show"/>
                    <field name="assigned_date" optional="show"/>
                    <field name="assigned_to" optional="show"/>
                    <field name="final_count" optional="show"/>
                    <field name="demo_download" optional="show"/>
                    <field name="manual" optional="show"/>
                    <field name="facesheet_missing" optional="show"/>
                    <field name="self_pay" optional="show"/>
                    <field name="ins_missing" optional="show"/>
                    <field name="chk_elig_nt_avail" optional="show"/>
                    <field name="others" optional="show"/>
                    <field name="demo_process_pstatus" optional="show"/>
                    <field name="posted_date" optional="show"/>
                    <field name="comments" optional="hide"/>
                    <field name="eligibility_report" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="view_demo_process_ams_allocation_form" model="ir.ui.view">
            <field name="name">ams.allocation.form</field>
            <field name="model">demo.process</field>
            <field name="arch" type="xml">
                <form string="AMS">
                    <header>
                        <field name="demo_process_pstatus" widget="statusbar" readonly="1"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="type" readonly="1"/>
                                <field name="received_date"/>
                                <field name="scan_date"/>
                                <field name="dos"/>
                            </group>
                            <group>
                                <field name="demo_station"/>
                                <field name="facility"/>
                                <field name="updated_facility"/>
                                <field name="demo_count"/>
                            </group>
                        </group>
                        <group  string="Supervisor User Entry">
                            <group>
                                <field name="assigned_employee_id"/>
                                <field name="assigned_date"/>
                                <field name="athena_id" />
                            </group>
                        </group>
                        <group string="User Entry">
                            <group>
                                <field name="final_count"/>
                                <field name="demo_download"/>
                                <field name="manual"/>
                                <field name="facesheet_missing"/>
                                <field name="self_pay"/>
                                <field name="ins_missing"/>
                            </group>
                            <group>
                                <field name="chk_elig_nt_avail"/>
                                <field name="others"/>
                                <field name="comments"/>
                                <field name="eligibility_report"/>
                                <field name="demo_process_pstatus"/>
                                <field name="posted_date"/>
                            </group>
                        </group>
                        <group string="Auditor Status" name="auditor_status">
                            <group>
                                <field name="auditor_user_id"/>
                                <field name="audited_date"/>
                                <field name="auditor_status"/>
                                <field name="error_count"/>
                                <field name="incorrect"/>
                            </group>
                            <group>
                                <field name="missed"/>
                                <field name="navigation"/>
                                <field name="error_comments"/>
                                <field name="error_category_id"/>
                            </group>
                        </group>
                        <group string="ERROR FIXING BY USER" name="error_fixing_by_user">
                            <group>
                                <field name="fixing_date"/>
                                <field name="updated_bar_batch"/>
                            </group>
                            <group>
                                <field name="comments"/>
                                <field name="reprocessing_id"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Notes">
                                <field name="demo_process_note_lines">
                                    <tree editable="bottom">
                                        <field name="date_image" />
                                        <field name="imaging_type" />
                                        <field name="description" />
                                        <field name="date_entered" />
                                        <field name="page_count" />
                                        <field name="entered_by" />
                                        <field name="patient_no" />
                                        <field name="notes" />
                                        <field name="reporting_remark" />
                                        <field name="error_mark" />
                                        <field name="demo_station_id" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

                <record id="demo_process_view_search" model="ir.ui.view">
                    <field name="name">demo.process.search</field>
                    <field name="model">demo.process</field>
                    <field name="arch" type="xml">
                        <search>
                <field name="facility"/>
                <field name="demo_station"/>
                <field name="demo_process_pstatus"/>


                <group expand="0" string="Group by...">
                    <filter name="demo_station_group" context="{'group_by' : 'demo_station'}" string="Division"/>
                    <filter name="status_id_group" context="{'group_by' : 'demo_process_pstatus'}" string="Production Status"/>
                    <filter string="Today" name="today" domain="[('write_date', '&gt;', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                </group>
                <filter name="unassigned_status_id" domain="[('demo_process_pstatus', '=', 'Unassigned')]" string="Unassigned"/>
<!--                <filter name="unassigned_audit_id" domain="[('audit_id', '=', 'Unassigned')]" string="Audit - Unassigned"/>-->
                <separator/>
                <filter string="Active" name="active_true" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="active_false" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Today Created Record" name="today_created_records" domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('create_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <separator/>
                <filter name="my_tasks" string="My Tasks" domain="[('assigned_to', '=', uid)]"/>


            </search>
                    </field>
                </record>


        <record id="action_demo_process_ams_allocation" model="ir.actions.act_window">
            <field name="name">Allocation - AMS</field>
            <field name="res_model">demo.process</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('type', '=', 'ams')]</field>
            <field name="context">{'search_default_unassigned_status_id': 1,'default_type': 'ams'}</field>
            <!--            <field name="search_view_id" ref="payment_posting_etm_search_view" />-->
            <field name="view_ids" eval="[(5, 0, 0),
                    (0, 0, {'view_mode': 'tree', 'view_id': ref('view_demo_process_ams_allocation_tree')}),
                    (0, 0, {'view_mode': 'form', 'view_id': ref('view_demo_process_ams_allocation_form')})]"/>

        </record>


    </data>
</odoo>